{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "watch",
      "problemMatcher": "$tsc-watch",
      "isBackground": true,
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "label": "npm: watch"
    },
    {
      "type": "npm",
      "script": "watch:webview",
      "isBackground": true,
      "label": "npm: watch:webview",
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^(?:vite|Error:)\\s+(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "building client environment",
          "endsPattern": "watching for file changes"
        }
      }
    },
    {
      "label": "watch all (tsc + vite webview)",
      "dependsOrder": "parallel",
      "dependsOn": ["npm: watch", "npm: watch:webview"],
      "problemMatcher": [],
      "group": "build"
    },
    {
      "type": "npm",
      "script": "compile",
      "problemMatcher": "$tsc",
      "group": "build",
      "label": "npm: compile"
    }
  ]
}
