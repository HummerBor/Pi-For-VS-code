{
  "name": "pi-for-vscode",
  "displayName": "Pi For VSC",
  "description": "VS Code 图形界面 for pi coding agent（进程内直连）",
  "version": "0.0.88",
  "publisher": "HummerBor",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/HummerBor/Pi-For-VS-code.git"
  },
  "icon": "media/pi-icon.png",
  "keywords": [
    "pi",
    "coding-agent",
    "ai",
    "chat",
    "claude-code"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "piChat",
          "title": "Pi For VSC",
          "icon": "media/pi-logo.svg"
        }
      ]
    },
    "views": {
      "piChat": [
        {
          "type": "webview",
          "id": "piChat.view",
          "name": "Pi For VSC"
        }
      ]
    },
    "commands": [
      {
        "command": "piChat.view.focus",
        "title": "pi: 打开聊天面板",
        "category": "pi"
      }
    ],
    "configuration": {
      "title": "pi Chat",
      "properties": {
        "piChat.backgroundImage": {
          "type": "string",
          "default": "",
          "description": "面板背景图：本地图片路径或 https 链接，留空不启用（重启面板或改配置即时生效）"
        },
        "piChat.backgroundOpacity": {
          "type": "number",
          "default": 0.35,
          "minimum": 0,
          "maximum": 1,
          "description": "面板背景图不透明度 0-1"
        },
        "piChat.sessionMode": {
          "type": "string",
          "enum": [
            "ephemeral",
            "continue",
            "new"
          ],
          "enumDescriptions": [
            "不保存会话（关闭即丢失，慎用）",
            "启动时继续最近一次会话（默认，历史自动保存）",
            "新建持久会话（保存到 ~/.pi/agent/sessions）"
          ],
          "default": "continue",
          "description": "pi RPC 进程的会话模式（修改后重启调试生效）"
        },
        "piChat.sessionDir": {
          "type": "string",
          "default": "",
          "description": "自定义 pi 会话存储目录（留空用默认 ~/.pi/agent/sessions，重启 pi 后生效）"
        },
        "piChat.autoRetry": {
          "type": "boolean",
          "default": true,
          "description": "模型请求失败时自动重试（超时/过载/限流），启动 pi 时自动应用"
        },
        "piChat.contextWarnPercent": {
          "type": "number",
          "default": 70,
          "minimum": 1,
          "maximum": 100,
          "description": "上下文占用超过该百分比时，面板顶部提醒建议压缩（同一会话只提醒一次，压缩后重置）"
        },
        "piChat.steeringMode": {
          "type": "string",
          "enum": [
            "one-at-a-time",
            "all"
          ],
          "enumDescriptions": [
            "逐条：排队消息一条条送达，每条等上一轮回复结束（Claude Code 风格）",
            "全部：所有排队插话在下一轮一次性送达"
          ],
          "default": "one-at-a-time",
          "description": "插话送达方式（启动 pi 时自动应用，⚙ 菜单可切换）"
        }
      }
    }
  },
  "scripts": {
    "typecheck:webview": "tsc -p webview --noEmit",
    "build:webview": "vite build",
    "watch:webview": "vite build --watch",
    "compile": "npm run typecheck:webview && npm run build:webview && tsc -p ./",
    "test:detail": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/toolDetail.test.mts",
    "test:revert": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/patchRevert.test.mts",
    "package": "npm run compile && npx @vscode/vsce package",
    "release": "npm version patch --no-git-tag-version && npm run compile && npx @vscode/vsce package",
    "ship": "npm run release && node scripts/publish.js",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0",
    "vite": "^8.2.2"
  }
}
