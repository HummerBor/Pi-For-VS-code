{
  "name": "pi-for-vscode",
  "displayName": "Pi For VSC",
  "description": "VS Code 图形界面 for pi coding agent（进程内直连）",
  "version": "0.1.50",
  "publisher": "HummerBor",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/HummerBor/Pi-For-VS-code.git"
  },
  "icon": "media/pi-icon.png",
  "keywords": [
    "pi",
    "coding-agent",
    "ai",
    "chat",
    "claude-code"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "main": "./out/vscode/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:piChat.editorPanel"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "piChat",
          "title": "Pi For VSC",
          "icon": "media/pi-logo.svg",
          "when": "piChat.doesNotSupportSecondarySidebar"
        },
        {
          "id": "piChatSessions",
          "title": "pi 会话",
          "icon": "media/pi-logo.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "piChatSecondary",
          "title": "Pi For VSC",
          "icon": "media/pi-logo.svg",
          "when": "!piChat.doesNotSupportSecondarySidebar"
        }
      ]
    },
    "views": {
      "piChat": [
        {
          "type": "webview",
          "id": "piChat.view",
          "name": "Pi For VSC",
          "when": "piChat.doesNotSupportSecondarySidebar"
        }
      ],
      "piChatSessions": [
        {
          "type": "webview",
          "id": "piChat.sessions",
          "name": ""
        }
      ],
      "piChatSecondary": [
        {
          "type": "webview",
          "id": "piChat.viewSecondary",
          "name": "Pi For VSC",
          "when": "!piChat.doesNotSupportSecondarySidebar"
        }
      ]
    },
    "commands": [
      {
        "command": "piChat.view.focus",
        "title": "pi: 打开聊天面板",
        "category": "pi"
      },
      {
        "command": "piChat.openInEditor",
        "title": "pi: 新建会话（编辑器标签）",
        "category": "pi",
        "icon": "media/source/pi-icon-small.svg"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "piChat.openInEditor",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "pi Chat",
      "properties": {
        "piChat.backgroundImage": {
          "type": "string",
          "default": "",
          "description": "面板背景图：本地图片路径或 https 链接，留空不启用（重启面板或改配置即时生效）"
        },
        "piChat.backgroundOpacity": {
          "type": "number",
          "default": 0.35,
          "minimum": 0,
          "maximum": 1,
          "description": "面板背景图不透明度 0-1"
        },
        "piChat.sessionMode": {
          "type": "string",
          "enum": [
            "continue",
            "new"
          ],
          "enumDescriptions": [
            "启动时继续最近一次会话（默认，历史自动保存）",
            "新建持久会话（保存到 ~/.pi/agent/sessions）"
          ],
          "default": "continue",
          "description": "启动时如何接续会话（修改后重启生效）"
        },
        "piChat.sessionDir": {
          "type": "string",
          "default": "",
          "description": "自定义 pi 会话存储目录（留空用默认 ~/.pi/agent/sessions，重启 pi 后生效）"
        },
        "piChat.autoRetry": {
          "type": "boolean",
          "default": true,
          "description": "模型请求失败时自动重试（超时/过载/限流），启动 pi 时自动应用"
        },
        "piChat.contextWarnPercent": {
          "type": "number",
          "default": 70,
          "minimum": 1,
          "maximum": 100,
          "description": "上下文占用超过该百分比时，面板顶部提醒建议压缩（同一会话只提醒一次，压缩后重置）"
        },
        "piChat.steeringMode": {
          "type": "string",
          "enum": [
            "one-at-a-time",
            "all"
          ],
          "enumDescriptions": [
            "逐条：排队消息一条条送达，每条等上一轮回复结束（Claude Code 风格）",
            "全部：所有排队插话在下一轮一次性送达"
          ],
          "default": "one-at-a-time",
          "description": "插话送达方式（启动 pi 时自动应用，⚙ 菜单可切换）"
        }
      }
    }
  },
  "scripts": {
    "typecheck:webview": "tsc -p webview --noEmit",
    "build:webview": "node scripts/build/clean-webview.mjs && vite build && vite build --config vite.sessions.config.mts",
    "watch:webview": "node scripts/build/watch-webview.mjs",
    "compile": "node scripts/release/vendor-pi.mjs && npm run typecheck:webview && npm run build:webview && tsc -p ./",
    "test:detail": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test/toolDetail.test.mts",
    "test:subagent": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test/subagentSnapshot.test.mts",
    "test:revert": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test/patchRevert.test.mts",
    "test:migration": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test/modelMemoryMigration.test.mts",
    "test:linkify": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test/linkify.test.mts",
    "test:errclass": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test/errorClass.test.mts",
    "test:html": "node scripts/test/html.test.mjs",
    "package": "node scripts/release/bump-version.mjs && npm run compile && npx @vscode/vsce package",
    "release": "npm run compile && npx @vscode/vsce package",
    "ship": "node scripts/release/bump-from-market.mjs && npm run release && node scripts/release/publish.js",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0",
    "vite": "^8.2.2"
  }
}
